// テーブル構造と責務・値の規則の正本。保存形式とSQLite型の対応は data.md を参照。
// 全テーブルはSQLite STRICT。主キー以外の一意制約・追加索引・CHECK制約は設けない。
// 外部キーの更新時動作は全て NO ACTION。論理参照を外部キーに置き換えない。

Table hubs {
  Note: '情報の提供元であるHub。利用者が設定画面から登録し、状態を受信する前から存在する。登録順は行の登録順（rowid）で表す。'
  hub_id text [not null, pk, note: '登録時にアプリケーションが採番する不変の識別子（UUID）']
  name text [not null, note: '利用者が登録する表示名。一意制約は設けない']
  url text [not null, note: '接続先のURL（`http(s)://ホスト[:ポート]`）。設定画面にだけ返し、閲覧用API・ログ・通知には含めない。移行前から存在するHubは空文字']
  token text [not null, note: '接続の認証トークン。平文で保存し、API応答・画面・ログ・通知には含めない。移行前から存在するHubは空文字']
  connected boolean [not null, note: '受信状態が「受信中」なら1、「再接続中」なら0']
}

Table hub_states {
  Note: '受信データ。最後に受けた snapshot・stats の stats 全体をHubごとに0件または1件保持する。freshness は反映しない。'
  hub_id text [not null, pk, note: '受信元のHub']
  stats_json json [not null, note: 'stats 全体のJSON']
  received_at timestamp [not null, note: '最後に保存に成功した通知のローカル受信時刻。UTC の ISO 8601']
}

Table hub_summaries {
  Note: 'Hub単位の概要。'
  hub_id text [not null, pk, note: '対象のHub']
  updated_at timestamp [not null, note: 'Hubがデータを更新した時刻']
  active_days integer [null, note: 'Hubが集計したアクティブ日数。Hubが送らない場合はNULL']
}

Table devices {
  Note: 'Hubに利用状況を送っている端末。'
  hub_id text [not null, note: '端末が属するHub']
  device_id text [not null, note: 'Hub内の端末識別子']
  hostname text [not null, note: 'ホスト名']
  os_name text [null, note: 'OS名']
  updated_at timestamp [not null, note: '端末が最後に送信した時刻']
  stale boolean [not null, note: 'Hubが鮮度切れと判定した場合は1、それ以外は0']

  indexes {
    (hub_id, device_id) [pk]
  }
}

Table latest_token_usages {
  Note: '端末・期間・ツール・モデルごとのトークン利用実績。'
  hub_id text [not null, note: '端末が属するHub']
  device_id text [not null, note: '利用した端末']
  period text [not null, note: '`today`・`month`・`all_time`']
  tool text [not null, note: 'ツール識別子']
  model text [not null, note: 'モデル識別子']
  tokens integer [not null, note: 'トークン数']
  cost_usd float [null, note: '推定コスト（USD）。Hubが送らない場合はNULL']

  indexes {
    (hub_id, device_id, period, tool, model) [pk]
  }
}

Table daily_token_usages {
  Note: 'Hubが送った日別のトークン利用実績。Hubごとに、日付1つにつき1行を持つ。受信のたびに、受け取った日付だけを上書きまたは追加し、他の日付の行は消さない。'
  hub_id text [not null, note: '日別の集計を送ったHub']
  date date [not null, note: 'Hubが送る日付（`YYYY-MM-DD`）。時刻帯の変換はしない']
  tokens integer [not null, note: 'その日の合計トークン数']
  cost_usd float [null, note: 'その日の推定コスト（USD）。Hubが送らない場合はNULL']

  indexes {
    (hub_id, date) [pk]
  }
}

Table device_daily_model_usages {
  Note: 'Hub・端末・日付・モデルごとの利用実績。同じモデル名はツール間で合算する。履歴取得可否のカラムは設けない。明細の有無は保存済みの行から判断する。'
  hub_id text [not null, note: '端末が属するHub']
  device_id text [not null, note: '利用した端末']
  date date [not null, note: '端末が報告した日付（`YYYY-MM-DD`）。時刻帯の変換はしない']
  model text [not null, note: 'モデル名']
  tokens integer [not null, note: 'その日のトークン数']
  cost_usd float [null, note: 'その日の推定コスト（USD）。不明ならNULL']

  indexes {
    (hub_id, device_id, date, model) [pk]
  }
}

Table accounts {
  Note: 'AIツールの利用アカウント。複数のHub・端末から同じアカウントが報告される。'
  provider text [not null, note: '提供元のサービス']
  account_key text [not null, note: 'Hubが付与するハッシュ化されたアカウント識別子']
  account_label text [null, note: 'アカウントの表示ラベル']
  plan_label text [null, note: '契約プランの表示ラベル']

  indexes {
    (provider, account_key) [pk]
  }
}

Table hub_accounts {
  Note: 'Hubが利用枠を報告した契約（Hub×アカウント）。メーターを表示する枠を一度でも報告した契約を保持し、報告されなくなっても削除しない（Hubの削除で消える）。利用枠の行を残すための親で、枠の行がすべて消えた契約の行は閲覧には現れない。'
  hub_id text [not null, note: '報告したHub']
  provider text [not null, note: 'アカウントの提供元']
  account_key text [not null, note: 'アカウント識別子']

  indexes {
    (hub_id, provider, account_key) [pk]
  }
}

Table latest_limit_windows {
  Note: 'Hubが報告した契約の利用枠。メーターを表示する枠を保持し、報告されなくなった枠も、最後に記録した `resets_at` を過ぎるまで、残量・`resets_at`・メーターの最終変更時刻を最後に記録した値のまま残す（過ぎた後の、そのHubの次の保存で削除する。`resets_at` が無い枠は、報告されなくなった保存で削除する）。報告中の枠との区別は持たない。'
  hub_id text [not null, note: '報告したHub']
  provider text [not null, note: 'アカウントの提供元']
  account_key text [not null, note: 'アカウント識別子']
  kind text [not null, note: '`session`・`daily`・`weekly`・`billing` などのリセット周期']
  limit_key text [not null, note: '枠の識別子。無い場合は枠の表示名']
  label text [null, note: '枠の表示名']
  remaining_percent float [not null, note: '残量（%）']
  used_percent float [null, note: '使用量（%）']
  resets_at timestamp [null, note: '次のリセット時刻']
  meter_changed_at timestamp [not null, note: 'remaining_percent・used_percent が最後に変わった保存時刻']
  window_minutes float [null, note: 'Hubが報告した枠の長さ（分）。Hubが送らない枠はNULL。画面は、NULLの枠の長さを `kind` の固定表で補う']

  indexes {
    (hub_id, provider, account_key, kind, limit_key) [pk]
  }
}

Ref: hubs.hub_id - hub_states.hub_id [delete: cascade, update: no action]
Ref: hubs.hub_id - hub_summaries.hub_id [delete: cascade, update: no action]
Ref: devices.hub_id > hubs.hub_id [delete: cascade, update: no action]
Ref: latest_token_usages.(hub_id, device_id) > devices.(hub_id, device_id) [delete: cascade, update: no action]
Ref: daily_token_usages.hub_id > hubs.hub_id [delete: cascade, update: no action]
Ref: device_daily_model_usages.(hub_id, device_id) > devices.(hub_id, device_id) [delete: cascade, update: no action]
Ref: hub_accounts.hub_id > hubs.hub_id [delete: cascade, update: no action]
Ref: hub_accounts.(provider, account_key) > accounts.(provider, account_key) [delete: no action, update: no action]
Ref: latest_limit_windows.(hub_id, provider, account_key) > hub_accounts.(hub_id, provider, account_key) [delete: cascade, update: no action]
