<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="mise.local.props" Condition="Exists('mise.local.props')" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>App</AssemblyName>
    <RootNamespace>NotesSample</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure/Persistence/Migrations/*.sql" LogicalName="App.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="BuildFrontend" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipFrontendBuild)' != 'true'">
    <Error Condition="'$(MiseExecutable)' == '' or !Exists('$(MiseExecutable)')" Text="miseの実体パスが未設定または無効です。プロジェクトのルートで mise run setup を実行してください。" />
    <Exec Command="&quot;$(MiseExecutable)&quot; exec -- node scripts/build-frontend.mjs" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
  </Target>
  <Target Name="CopyFrontendToOutput" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="BuildFrontend" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipFrontendBuild)' != 'true'">
    <ItemGroup>
      <_FrontendFiles Include="../frontend/dist/**/*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)wwwroot" />
    <Copy SourceFiles="@(_FrontendFiles)" DestinationFiles="@(_FrontendFiles->'$(TargetDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyFrontendToPublish" AfterTargets="Publish" DependsOnTargets="BuildFrontend" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipFrontendBuild)' != 'true'">
    <ItemGroup>
      <_FrontendPublishFiles Include="../frontend/dist/**/*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <Copy SourceFiles="@(_FrontendPublishFiles)" DestinationFiles="@(_FrontendPublishFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
