{
  "name": "aidd-react-dotnet-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "routes": "tsr generate",
    "typecheck": "npm run routes && tsc -p tsconfig.json",
    "lint": "eslint contracts frontend/src tests scripts --ignore-pattern frontend/src/routeTree.gen.ts",
    "format": "prettier --write contracts frontend/src frontend/vite.config.ts tests scripts *.json *.ts",
    "format:check": "prettier --check contracts frontend/src frontend/vite.config.ts tests scripts *.json *.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test:core": "dotnet test App.slnx --no-restore -p:SkipFrontendBuild=true",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs hosted",
    "test:e2e:repeat": "node scripts/test-e2e.mjs hosted --workers=4 --repeat-each=3",
    "verify": "node scripts/verify.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/db.mjs backup",
    "db:check": "node --env-file-if-exists=.env scripts/db.mjs check",
    "package": "npm run verify && node scripts/package.mjs",
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check"
  },
  "dependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
