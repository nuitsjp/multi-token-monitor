{
  "openapi": "3.0.4",
  "info": {
    "title": "MultiTokenMonitor | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "MultiTokenMonitor"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "tags": [
          "MultiTokenMonitor"
        ],
        "operationId": "GetOverview",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/hub-usage": {
      "get": {
        "tags": [
          "MultiTokenMonitor"
        ],
        "operationId": "GetHubUsage",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HubUsageDataOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/limit-history": {
      "get": {
        "tags": [
          "MultiTokenMonitor"
        ],
        "operationId": "GetLimitHistory",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LimitHistoryOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/hubs": {
      "get": {
        "tags": [
          "MultiTokenMonitor"
        ],
        "operationId": "GetHubs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HubRegistrationOutput"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ApiEndpoints"
        ],
        "operationId": "AddHub",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddHubInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HubRegistrationOutput"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityDayOutput": {
        "required": [
          "date",
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "AddHubInput": {
        "required": [
          "name",
          "url",
          "token"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EstimateStatus": {
        "enum": [
          "estimated",
          "estimating",
          "unavailable"
        ]
      },
      "HealthOutput": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "HubRegistrationOutput": {
        "required": [
          "hubId",
          "name",
          "url",
          "status"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "HubUsageDataOutput": {
        "required": [
          "today",
          "hubs"
        ],
        "type": "object",
        "properties": {
          "today": {
            "type": "string"
          },
          "hubs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HubUsageHubOutput"
            }
          }
        }
      },
      "HubUsageDayOutput": {
        "required": [
          "date",
          "deviceId",
          "model",
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "HubUsageDeviceOutput": {
        "required": [
          "deviceId",
          "hostname",
          "osName",
          "updatedAt",
          "stale"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "osName": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "HubUsageHubOutput": {
        "required": [
          "hubId",
          "name",
          "connected",
          "receivedAt",
          "devices",
          "days"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "receivedAt": {
            "type": "string",
            "nullable": true
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HubUsageDeviceOutput"
            }
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HubUsageDayOutput"
            }
          }
        }
      },
      "HubUsageOutput": {
        "required": [
          "hubId",
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "LimitHistoryContractOutput": {
        "required": [
          "key",
          "hubId",
          "hubName",
          "provider",
          "plan"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "hubId": {
            "type": "string"
          },
          "hubName": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LimitHistoryDayOutput": {
        "required": [
          "contractKey",
          "date",
          "monthlyLimitUsd",
          "priceUsd",
          "lowerBound"
        ],
        "type": "object",
        "properties": {
          "contractKey": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "monthlyLimitUsd": {
            "type": "number",
            "format": "double"
          },
          "priceUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "lowerBound": {
            "type": "boolean"
          }
        }
      },
      "LimitHistoryOutput": {
        "required": [
          "today",
          "contracts",
          "days"
        ],
        "type": "object",
        "properties": {
          "today": {
            "type": "string"
          },
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LimitHistoryContractOutput"
            }
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LimitHistoryDayOutput"
            }
          }
        }
      },
      "ModelUsageOutput": {
        "required": [
          "tool",
          "model",
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "OverviewActivityOutput": {
        "required": [
          "days"
        ],
        "type": "object",
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityDayOutput"
            }
          }
        }
      },
      "OverviewDeviceOutput": {
        "required": [
          "hubId",
          "deviceId",
          "hostname",
          "osName",
          "updatedAt",
          "stale"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "osName": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "OverviewHubOutput": {
        "required": [
          "hubId",
          "name",
          "connected",
          "receivedAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "receivedAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "OverviewLimitWindowOutput": {
        "required": [
          "hubId",
          "provider",
          "accountKey",
          "accountLabel",
          "planLabel",
          "kind",
          "limitKey",
          "label",
          "remainingPercent",
          "resetsAt",
          "estimatedLimitUsd",
          "estimate",
          "unavailableReason",
          "windowMinutes"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "accountKey": {
            "type": "string"
          },
          "accountLabel": {
            "type": "string",
            "nullable": true
          },
          "planLabel": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string"
          },
          "limitKey": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "remainingPercent": {
            "type": "number",
            "format": "double"
          },
          "resetsAt": {
            "type": "string",
            "nullable": true
          },
          "estimatedLimitUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "estimate": {
            "$ref": "#/components/schemas/EstimateStatus"
          },
          "unavailableReason": {
            "oneOf": [
              {
                "enum": [
                  null
                ],
                "nullable": true
              },
              {
                "$ref": "#/components/schemas/UnavailableReason"
              }
            ]
          },
          "windowMinutes": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "OverviewOutput": {
        "required": [
          "hubs",
          "periods",
          "limitWindows",
          "devices",
          "activity"
        ],
        "type": "object",
        "properties": {
          "hubs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OverviewHubOutput"
            }
          },
          "periods": {
            "$ref": "#/components/schemas/OverviewPeriodsOutput"
          },
          "limitWindows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OverviewLimitWindowOutput"
            }
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OverviewDeviceOutput"
            }
          },
          "activity": {
            "$ref": "#/components/schemas/OverviewActivityOutput"
          }
        }
      },
      "OverviewPeriodOutput": {
        "required": [
          "total",
          "hubs",
          "models"
        ],
        "type": "object",
        "properties": {
          "total": {
            "$ref": "#/components/schemas/UsageOutput"
          },
          "hubs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HubUsageOutput"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelUsageOutput"
            }
          }
        }
      },
      "OverviewPeriodsOutput": {
        "required": [
          "today",
          "month",
          "allTime"
        ],
        "type": "object",
        "properties": {
          "today": {
            "$ref": "#/components/schemas/OverviewPeriodOutput"
          },
          "month": {
            "$ref": "#/components/schemas/OverviewPeriodOutput"
          },
          "allTime": {
            "$ref": "#/components/schemas/OverviewPeriodOutput"
          }
        }
      },
      "UnavailableReason": {
        "enum": [
          "unknown-source-device",
          "shared-source-device",
          "no-matching-model",
          "not-countable",
          null
        ]
      },
      "UsageOutput": {
        "required": [
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "MultiTokenMonitor"
    },
    {
      "name": "ApiEndpoints"
    }
  ]
}
