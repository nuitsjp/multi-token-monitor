{
  "openapi": "3.0.4",
  "info": {
    "title": "MultiTokenMonitor | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "MultiTokenMonitor"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutput"
                }
              }
            }
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "tags": [
          "MultiTokenMonitor"
        ],
        "operationId": "GetOverview",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityDayOutput": {
        "required": [
          "date",
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "HealthOutput": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HubUsageOutput": {
        "required": [
          "hubId",
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "ModelUsageOutput": {
        "required": [
          "tool",
          "model",
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "OverviewActivityOutput": {
        "required": [
          "days"
        ],
        "type": "object",
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityDayOutput"
            }
          }
        }
      },
      "OverviewDeviceOutput": {
        "required": [
          "hubId",
          "deviceId",
          "hostname",
          "osName",
          "updatedAt",
          "stale"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "osName": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "OverviewHubOutput": {
        "required": [
          "hubId",
          "name",
          "connected",
          "receivedAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "receivedAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "OverviewLimitWindowOutput": {
        "required": [
          "hubId",
          "provider",
          "accountKey",
          "accountLabel",
          "planLabel",
          "kind",
          "limitKey",
          "label",
          "remainingPercent",
          "resetsAt",
          "estimatedLimitUsd",
          "windowMinutes"
        ],
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "accountKey": {
            "type": "string"
          },
          "accountLabel": {
            "type": "string",
            "nullable": true
          },
          "planLabel": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string"
          },
          "limitKey": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "remainingPercent": {
            "type": "number",
            "format": "double"
          },
          "resetsAt": {
            "type": "string",
            "nullable": true
          },
          "estimatedLimitUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "windowMinutes": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      },
      "OverviewOutput": {
        "required": [
          "hubs",
          "periods",
          "limitWindows",
          "devices",
          "activity"
        ],
        "type": "object",
        "properties": {
          "hubs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OverviewHubOutput"
            }
          },
          "periods": {
            "$ref": "#/components/schemas/OverviewPeriodsOutput"
          },
          "limitWindows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OverviewLimitWindowOutput"
            }
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OverviewDeviceOutput"
            }
          },
          "activity": {
            "$ref": "#/components/schemas/OverviewActivityOutput"
          }
        }
      },
      "OverviewPeriodOutput": {
        "required": [
          "total",
          "hubs",
          "models"
        ],
        "type": "object",
        "properties": {
          "total": {
            "$ref": "#/components/schemas/UsageOutput"
          },
          "hubs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HubUsageOutput"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelUsageOutput"
            }
          }
        }
      },
      "OverviewPeriodsOutput": {
        "required": [
          "today",
          "month",
          "allTime"
        ],
        "type": "object",
        "properties": {
          "today": {
            "$ref": "#/components/schemas/OverviewPeriodOutput"
          },
          "month": {
            "$ref": "#/components/schemas/OverviewPeriodOutput"
          },
          "allTime": {
            "$ref": "#/components/schemas/OverviewPeriodOutput"
          }
        }
      },
      "UsageOutput": {
        "required": [
          "tokens",
          "costUsd"
        ],
        "type": "object",
        "properties": {
          "tokens": {
            "type": "integer",
            "format": "int64"
          },
          "costUsd": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "MultiTokenMonitor"
    }
  ]
}
